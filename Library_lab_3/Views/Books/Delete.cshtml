@model Library_lab_3.Models.Book

<h1>Delete book</h1>

<p>
    Are you sure you want to delete this book?
</p>

<h4>
    @Model.Title
</h4>

<p>
    <strong>Authors:</strong>

    @string.Join(", ",
        Model.Authors.Select(a =>
            a.LastName + " " +
            a.FirstName + " " +
            (a.MiddleName ?? "")
        ))
</p>

<p>
    <strong>Price:</strong>
    @Model.Price
</p>

<form asp-action="Delete"
      method="post">

    <input type="hidden"
           asp-for="Id" />

    <button type="submit"
            class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>