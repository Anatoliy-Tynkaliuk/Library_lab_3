@model Library_lab_3.Models.Author

<h1>Edit author</h1>

<form asp-action="Edit" method="post">

    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="LastName"
               class="form-label">
            Last Name
        </label>

        <input asp-for="LastName"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="FirstName"
               class="form-label">
            First Name
        </label>

        <input asp-for="FirstName"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="MiddleName"
               class="form-label">
            Middle Name
        </label>

        <input asp-for="MiddleName"
               class="form-control" />
    </div>

    <button type="submit"
            class="btn btn-primary">
        Save
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Back
    </a>

</form>