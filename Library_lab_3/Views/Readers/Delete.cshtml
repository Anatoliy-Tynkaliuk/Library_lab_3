@model Library_lab_3.Models.Reader

<h1>Delete reader</h1>

<p>
    Are you sure you want to delete:
</p>

<h4>
    @Model.LastName
    @Model.FirstName
    @Model.MiddleName
</h4>

<form asp-action="Delete"
      method="post">

    <input type="hidden"
           asp-for="Id" />

    <button type="submit"
            class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>